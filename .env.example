# Copy to `.env` and fill in your own values. Never commit the real file.
#
# OAuth setup order:
# 1. Deploy `oauth-relay/` (`npm run deploy`) and copy the printed URL.
# 2. In Cloudflare: Manage account → OAuth clients → create a client.
#    Redirect URL = https://<that-worker-host>/callback
#    Token auth method = none (public PKCE client).
# 3. Paste the client id and the same /callback URL here, then restart Metro.
#
# Leave both empty to hide "Sign in with Cloudflare". API tokens do not need
# this Worker.

EXPO_PUBLIC_CF_OAUTH_CLIENT_ID=
EXPO_PUBLIC_CF_OAUTH_REDIRECT_URI=
